+func TestICMPErrorVariants(t *testing.T) {
+	for _, proto := range []byte{6, 17} {
+		for _, kind := range []byte{3, 11, 12} {
+			t.Run(fmt.Sprintf("proto%d/type%d", proto, kind), func(t *testing.T) {
+				d := natted(&fake{})
+				outbound := pkt(proto, lan, remote, 52000, 443, 0)
+				d.egress(outbound)
+				p := tooBig(outbound, len(outbound))
+				p[20], p[21] = kind, 0
+				repairErrorChecksums(p)
+				d.ingress(p)
+				if !bytes.Equal(p[16:20], lan[:]) || !bytes.Equal(p[40:44], lan[:]) || fold(sum(p[20:], 0)) != 0xffff {
+					t.Fatal("error translation failed")
+				}
+				q := p[28:]
+				off := map[byte]int{6: 36, 17: 26}[proto]
+				if binary.BigEndian.Uint16(q[off:off+2]) != l4Ck(proto, lan[:], remote[:], q[20:]) {
+					t.Fatal("quoted transport checksum invalid")
+				}
+			})
+		}
+	}
+}
