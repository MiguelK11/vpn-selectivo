+func TestFragmentedReplyReversed(t *testing.T) {
+	f := &fake{}
+	d := natted(f)
+	egress1(t, d, pkt(17, lan, remote, 40000, 5000, 0)) // establish the flow
+
+	first := pkt(17, remote, tunIP, 5000, 40000, 0)
+	binary.BigEndian.PutUint16(first[4:6], 0x1234)
+	first[6] |= 0x20 // more fragments
+	binary.BigEndian.PutUint16(first[10:12], ipCk(first[:20]))
+
+	second := make([]byte, 20+32)
+	second[0] = 0x45
+	binary.BigEndian.PutUint16(second[2:4], uint16(len(second)))
+	binary.BigEndian.PutUint16(second[4:6], 0x1234)
+	binary.BigEndian.PutUint16(second[6:8], 185) // offset 1480 bytes
+	second[8], second[9] = 64, 17
+	copy(second[12:16], remote[:])
+	copy(second[16:20], tunIP[:])
+	for i := 20; i < len(second); i++ {
+		second[i] = byte(i)
+	}
+	binary.BigEndian.PutUint16(second[10:12], ipCk(second[:20]))
+	payload := append([]byte(nil), second[20:]...)
+
+	stray := append([]byte(nil), second...) // same shape, unknown id
+	binary.BigEndian.PutUint16(stray[4:6], 0x9999)
+	binary.BigEndian.PutUint16(stray[10:12], ipCk(stray[:20]))
+
+	d.Write([][]byte{first}, 0)
+	d.Write([][]byte{second}, 0)
+	d.Write([][]byte{stray}, 0)
+
+	for i, want := range [][4]byte{lan, lan, tunIP} {
+		got := f.out[i]
+		if !bytes.Equal(got[16:20], want[:]) {
+			t.Fatalf("fragment %d dst = %v, want %v", i, got[16:20], want)
+		}
+		if w := ipCk(got[:20]); binary.BigEndian.Uint16(got[10:12]) != w {
+			t.Fatalf("fragment %d ip cksum wrong", i)
+		}
+	}
+	if !bytes.Equal(f.out[1][20:], payload) {
+		t.Fatal("later fragment payload was modified")
+	}
+	if w := l4Ck(17, remote[:], lan[:], f.out[0][20:]); binary.BigEndian.Uint16(f.out[0][26:28]) != w {
+		t.Fatal("first fragment udp cksum wrong after reversal")
+	}
+}
