+/* SPDX-License-Identifier: MIT
+ *
+ * VPNonly addition: rewrite the inner IPv4 source of packets entering the
+ * tunnel to the tunnel's own address, and reverse the rewrite on replies.
+ *
+ * Why this exists: VPNonly steers selected apps into this tunnel with PF
+ * route-to. On macOS, PF evaluates translation rules against the interface
+ * the OS originally routed to, and a route-to'd packet skips them, so
+ * packets arrive here still carrying the LAN source address. Servers that
+ * enforce WireGuard cryptokey routing (Mullvad, Proton, stock wg servers)
+ * silently drop those. NordLynx NATs any inner source, which is why the
+ * problem stayed invisible until a strict provider was tried.
+ *
+ * Enabled only when WG_NAT_SOURCE is set to the tunnel's IPv4 address.
+ * Unset, this file changes nothing. On any packet it cannot safely parse,
+ * it passes the packet through untouched rather than risk corrupting it.
+ */
+
+package main
+
+import (
+	"encoding/binary"
+	"net"
+	"os"
+	"sync"
+	"time"
+
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+// maybeNAT wraps the tun device when WG_NAT_SOURCE names a valid IPv4
+// address, and returns it unchanged otherwise.
+func maybeNAT(tdev tun.Device, logger *device.Logger) tun.Device {
+	env := os.Getenv("WG_NAT_SOURCE")
+	if env == "" {
+		return tdev
+	}
+	v4 := net.ParseIP(env).To4()
+	if v4 == nil {
+		logger.Errorf("WG_NAT_SOURCE %q is not an IPv4 address; source rewriting disabled", env)
+		return tdev
+	}
+	var ip [4]byte
+	copy(ip[:], v4)
+	logger.Verbosef("Rewriting inner IPv4 source to %s", v4)
+	return newNATDevice(tdev, ip)
+}
+
+// newNATDevice is the single place the tables are built, so production and
+// tests can never disagree about which maps exist.
+func newNATDevice(tdev tun.Device, natIP [4]byte) *natDevice {
+	return &natDevice{
+		Device:   tdev,
+		natIP:    natIP,
+		flows:    make(map[flowKey][4]byte),
+		seen:     make(map[flowKey]int64),
+		frags:    make(map[fragKey][4]byte),
+		fragSeen: make(map[fragKey]int64),
+	}
+}
+
+// One tracked connection. The source port is left untouched by the rewrite,
+// so together with the remote address it identifies the flow both ways.
+type flowKey struct {
+	proto      byte
+	localPort  uint16 // original source port (or ICMP echo id)
+	remoteIP   [4]byte
+	remotePort uint16 // zero for ICMP
+}
+
+// A fragmented reply only carries ports in its first fragment. The rest are
+// matched to it by (source, IP id), so every piece gets the same destination
+// and the kernel can reassemble.
+type fragKey struct {
+	src [4]byte
+	id  uint16
+}
+
+type natDevice struct {
+	tun.Device
+	natIP [4]byte
+
+	mu       sync.Mutex
+	flows    map[flowKey][4]byte // flow -> original source address
+	seen     map[flowKey]int64   // flow -> unix seconds of last packet in either direction
+	frags    map[fragKey][4]byte // in-flight fragmented reply -> original destination
+	fragSeen map[fragKey]int64
+	inserts  int
+}
+
+const (
+	flowLimit  = 65536 // hard cap on tracked flows
+	flowIdle   = 600   // seconds before an idle flow may be dropped
+	sweepEvery = 4096  // inserts between opportunistic sweeps
+	fragLimit  = 4096  // fragmented datagrams remembered at once
+	fragIdle   = 30    // seconds a datagram's fragments may keep arriving
+)
+
+// Read is the egress path: packets from the OS on their way to the tunnel.
+func (d *natDevice) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	n, err := d.Device.Read(bufs, sizes, offset)
+	for i := 0; i < n; i++ {
+		if sizes[i] > 0 && offset+sizes[i] <= len(bufs[i]) {
+			d.egress(bufs[i][offset : offset+sizes[i]])
+		}
+	}
+	return n, err
+}
+
+// Write is the ingress path: decrypted packets from the tunnel to the OS.
+func (d *natDevice) Write(bufs [][]byte, offset int) (int, error) {
+	for i := range bufs {
+		if offset < len(bufs[i]) {
+			d.ingress(bufs[i][offset:])
+		}
+	}
+	return d.Device.Write(bufs, offset)
+}
+
+// header pulls the pieces of an IPv4 header this file cares about.
+// ok is false for anything that should be passed through untouched.
+func header(p []byte) (ihl int, proto byte, frag bool, ok bool) {
+	if len(p) < 20 || p[0]>>4 != 4 {
+		return 0, 0, false, false
+	}
+	ihl = int(p[0]&0x0f) * 4
+	if ihl < 20 || len(p) < ihl {
+		return 0, 0, false, false
+	}
+	// a nonzero fragment offset means no L4 header in this packet
+	frag = binary.BigEndian.Uint16(p[6:8])&0x1fff != 0
+	return ihl, p[9], frag, true
+}
+
+func (d *natDevice) egress(p []byte) {
+	ihl, proto, frag, ok := header(p)
+	if !ok {
+		return
+	}
+	var src [4]byte
+	copy(src[:], p[12:16])
+	if src == d.natIP {
+		return // already correct (bound sockets, our own traffic)
+	}
+
+	// Identify the flow before rewriting. Fragments past the first carry no
+	// L4 header: rewrite the address, skip the map (the first fragment of
+	// the same flow keyed it).
+	if !frag {
+		key := flowKey{proto: proto}
+		switch proto {
+		case 6, 17: // TCP, UDP
+			if len(p) < ihl+4 {
+				return
+			}
+			key.localPort = binary.BigEndian.Uint16(p[ihl : ihl+2])
+			key.remotePort = binary.BigEndian.Uint16(p[ihl+2 : ihl+4])
+		case 1: // ICMP echo request: the id plays the port's role
+			if len(p) < ihl+8 || p[ihl] != 8 {
+				return
+			}
+			key.localPort = binary.BigEndian.Uint16(p[ihl+4 : ihl+6])
+		default:
+			return // unknown protocol: better to leave it alone
+		}
+		copy(key.remoteIP[:], p[16:20])
+
+		d.mu.Lock()
+		_, exists := d.flows[key]
+		if !exists && len(d.flows) >= flowLimit {
+			d.sweepLocked(true)
+		}
+		if exists || len(d.flows) < flowLimit {
+			d.flows[key] = src
+			d.seen[key] = time.Now().Unix()
+			if !exists {
+				d.inserts++
+				if d.inserts%sweepEvery == 0 {
+					d.sweepLocked(false)
+				}
+			}
+		}
+		d.mu.Unlock()
+	}
+
+	rewrite(p, ihl, proto, frag, 12, src, d.natIP)
+}
+
+func (d *natDevice) ingress(p []byte) {
+	ihl, proto, frag, ok := header(p)
+	if !ok {
+		return
+	}
+	var dst [4]byte
+	copy(dst[:], p[16:20])
+	if dst != d.natIP {
+		return // not ours to reverse
+	}
+	var src [4]byte
+	copy(src[:], p[12:16])
+	fk := fragKey{src: src, id: binary.BigEndian.Uint16(p[4:6])}
+
+	if frag {
+		// A later fragment: no L4 header, so find the datagram by its first
+		// fragment. One that arrives before its first stays as it is.
+		d.mu.Lock()
+		orig, exists := d.frags[fk]
+		d.mu.Unlock()
+		if exists {
+			rewrite(p, ihl, proto, true, 16, dst, orig)
+		}
+		return
+	}
+
+	key := flowKey{proto: proto}
+	switch proto {
+	case 6, 17:
+		if len(p) < ihl+4 {
+			return
+		}
+		key.localPort = binary.BigEndian.Uint16(p[ihl+2 : ihl+4]) // reply dst port
+		key.remotePort = binary.BigEndian.Uint16(p[ihl : ihl+2])  // reply src port
+	case 1:
+		if len(p) < ihl+8 {
+			return
+		}
+		if p[ihl] == 3 || p[ihl] == 11 || p[ihl] == 12 {
+			d.icmpError(p, ihl)
+			return
+		}
+		if p[ihl] != 0 { // only echo replies have an identifier to match
+			return
+		}
+		key.localPort = binary.BigEndian.Uint16(p[ihl+4 : ihl+6])
+	default:
+		return
+	}
+	copy(key.remoteIP[:], p[12:16])
+
+	d.mu.Lock()
+	orig, exists := d.flows[key]
+	if exists {
+		d.seen[key] = time.Now().Unix()
+	}
+	if exists && p[6]&0x20 != 0 { // more fragments follow: remember for them
+		if len(d.frags) >= fragLimit {
+			d.sweepLocked(false)
+		}
+		d.frags[fk] = orig
+		d.fragSeen[fk] = time.Now().Unix()
+	}
+	d.mu.Unlock()
+	if !exists {
+		return // addressed to the tunnel itself, or a flow we never saw
+	}
+
+	rewrite(p, ihl, proto, false, 16, dst, orig)
+}
+
+// ICMP errors quote the outgoing packet, not the reply's transport ports.
+// Reverse both addresses so the kernel can match the original socket (and,
+// for fragmentation-needed errors, learn the path MTU). Unknown or malformed
+// quotes remain untouched. PF policy is unchanged.
+func (d *natDevice) icmpError(p []byte, ihl int) {
+	total := int(binary.BigEndian.Uint16(p[2:4]))
+	if total > len(p) || total < ihl+8+20+8 ||
+		binary.BigEndian.Uint16(p[6:8])&0x3fff != 0 || checksum(p[:ihl]) != 0 {
+		return // fragmented ICMP errors need reassembly before translation
+	}
+	msg := p[ihl:total]
+	if checksum(msg) != 0 {
+		return
+	}
+	quote := msg[8:]
+	// RFC 4884's optional length bounds the quote before any ICMP extensions.
+	if n := int(msg[5]) * 4; n != 0 {
+		if n > len(quote) {
+			return
+		}
+		quote = quote[:n]
+	}
+	qihl, proto, frag, ok := header(quote)
+	if !ok || frag || len(quote) < qihl+8 || checksum(quote[:qihl]) != 0 ||
+		(proto != 6 && proto != 17) {
+		return
+	}
+	qtotal := int(binary.BigEndian.Uint16(quote[2:4]))
+	if qtotal < qihl+8 {
+		return
+	}
+	if qtotal < len(quote) {
+		quote = quote[:qtotal]
+	}
+	var src [4]byte
+	copy(src[:], quote[12:16])
+	if src != d.natIP {
+		return
+	}
+	key := flowKey{proto: proto,
+		localPort:  binary.BigEndian.Uint16(quote[qihl : qihl+2]),
+		remotePort: binary.BigEndian.Uint16(quote[qihl+2 : qihl+4])}
+	copy(key.remoteIP[:], quote[16:20])
+	d.mu.Lock()
+	orig, exists := d.flows[key]
+	d.mu.Unlock()
+	if !exists {
+		return
+	}
+	rewrite(quote, qihl, proto, false, 12, src, orig)
+	msg[2], msg[3] = 0, 0
+	binary.BigEndian.PutUint16(msg[2:4], checksum(msg))
+	rewrite(p, ihl, 1, false, 16, d.natIP, orig)
+}
+
+func checksum(p []byte) uint16 {
+	var sum uint32
+	for len(p) >= 2 {
+		sum += uint32(binary.BigEndian.Uint16(p[:2]))
+		p = p[2:]
+	}
+	if len(p) == 1 {
+		sum += uint32(p[0]) << 8
+	}
+	for sum>>16 != 0 {
+		sum = sum&0xffff + sum>>16
+	}
+	return ^uint16(sum)
+}
+
+// rewrite replaces the 4-byte address at p[at:at+4] and repairs the IPv4
+// header checksum plus, when an L4 header is present, the TCP or UDP
+// checksum (both cover the address via the pseudo-header). ICMP checksums
+// don't cover addresses, so they need no repair.
+func rewrite(p []byte, ihl int, proto byte, frag bool, at int, old, new [4]byte) {
+	copy(p[at:at+4], new[:])
+	fix(p[10:12], old, new)
+	if frag {
+		return
+	}
+	switch proto {
+	case 6: // TCP checksum at offset 16
+		if len(p) >= ihl+18 {
+			fix(p[ihl+16:ihl+18], old, new)
+		}
+	case 17: // UDP checksum at offset 6; zero means "not used"
+		if len(p) >= ihl+8 && (p[ihl+6] != 0 || p[ihl+7] != 0) {
+			fix(p[ihl+6:ihl+8], old, new)
+			if p[ihl+6] == 0 && p[ihl+7] == 0 {
+				p[ihl+6], p[ihl+7] = 0xff, 0xff // 0 is reserved for "no checksum"
+			}
+		}
+	}
+}
+
+// fix applies RFC 1624 incremental checksum update for a changed address.
+func fix(sum []byte, old, new [4]byte) {
+	s := uint32(^binary.BigEndian.Uint16(sum)) & 0xffff
+	for i := 0; i < 4; i += 2 {
+		o := uint32(old[i])<<8 | uint32(old[i+1])
+		w := uint32(new[i])<<8 | uint32(new[i+1])
+		s += (^o & 0xffff) + w
+	}
+	for s>>16 != 0 {
+		s = (s & 0xffff) + (s >> 16)
+	}
+	binary.BigEndian.PutUint16(sum, ^uint16(s))
+}
+
+// sweepLocked drops idle flows. Under pressure (full=true) it halves the
+// idle threshold until something gives, so a burst of short connections
+// can't pin the table at its cap forever.
+func (d *natDevice) sweepLocked(full bool) {
+	now := time.Now().Unix()
+	for k, t := range d.fragSeen {
+		if now-t > fragIdle {
+			delete(d.frags, k)
+			delete(d.fragSeen, k)
+		}
+	}
+	idle := int64(flowIdle)
+	for {
+		for k, t := range d.seen {
+			if now-t > idle {
+				delete(d.flows, k)
+				delete(d.seen, k)
+			}
+		}
+		if !full || len(d.flows) < flowLimit || idle <= 1 {
+			return
+		}
+		idle /= 2
+	}
+}
