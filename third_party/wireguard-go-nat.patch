+func TestICMPErrorWithOptionsAndExtensions(t *testing.T) {
+	d := natted(&fake{})
+	base := pkt(6, lan, remote, 52000, 443, 0)
+	q := append(append(append([]byte{}, base[:20]...), 1, 1, 1, 1), base[20:]...)
+	q[0] = 0x46
+	binary.BigEndian.PutUint16(q[2:4], uint16(len(q)))
+	binary.BigEndian.PutUint16(q[10:12], ipCk(q[:24]))
+	d.egress(q)
+	p := tooBig(q, len(q))
+	// Pad quoted datagram to RFC 4884's minimum, then add opaque extension bytes.
+	p = append(p, make([]byte, 128-len(q))...)
+	extension := []byte{0x20, 0, 0xaa, 0xbb, 0, 4, 1, 1}
+	p = append(p, extension...)
+	p[25] = 32
+	binary.BigEndian.PutUint16(p[2:4], uint16(len(p)))
+	repairErrorChecksums(p)
+	d.ingress(p)
+	if !bytes.Equal(p[16:20], lan[:]) || !bytes.Equal(p[40:44], lan[:]) || !bytes.Equal(p[len(p)-len(extension):], extension) || fold(sum(p[20:], 0)) != 0xffff {
+		t.Fatal("options/extension translation corrupted packet")
+	}
+	if binary.BigEndian.Uint16(p[38:40]) != ipCk(p[28:52]) || binary.BigEndian.Uint16(p[68:70]) != l4Ck(6, lan[:], remote[:], p[52:72]) {
+		t.Fatal("quoted option-header checksums invalid")
+	}
+}
