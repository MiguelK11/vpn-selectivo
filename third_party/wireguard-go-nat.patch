+func repairErrorChecksums(p []byte) {
+	ihl := int(p[0]&15) * 4
+	p[ihl+2], p[ihl+3] = 0, 0
+	binary.BigEndian.PutUint16(p[ihl+2:ihl+4], ^fold(sum(p[ihl:], 0)))
+	binary.BigEndian.PutUint16(p[10:12], ipCk(p[:ihl]))
+}
