+func TestBidirectionalConcurrentNAT(t *testing.T) {
+	d := natted(&fake{})
+	d.egress(pkt(6, lan, remote, 52000, 443, 0))
+	done := make(chan bool)
+	go func() {
+		for i := 0; i < 2000; i++ {
+			d.egress(pkt(6, lan, remote, 52000, 443, 0))
+		}
+		done <- true
+	}()
+	for i := 0; i < 2000; i++ {
+		p := pkt(6, remote, tunIP, 443, 52000, 0)
+		d.ingress(p)
+		if !bytes.Equal(p[16:20], lan[:]) {
+			t.Fatal("reply mapping lost")
+		}
+	}
+	<-done
+}
