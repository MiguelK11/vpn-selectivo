+// A router's minimum-length ICMP error quotes an IPv4 header and 8 transport bytes.
+func tooBig(quoted []byte, n int) []byte {
+	p := make([]byte, 28+n)
+	p[0], p[8], p[9] = 0x45, 64, 1
+	binary.BigEndian.PutUint16(p[2:4], uint16(len(p)))
+	copy(p[12:16], []byte{192, 0, 2, 1})
+	copy(p[16:20], tunIP[:])
+	p[20], p[21] = 3, 4
+	binary.BigEndian.PutUint16(p[26:28], 1280)
+	copy(p[28:], quoted[:n])
+	binary.BigEndian.PutUint16(p[22:24], ^fold(sum(p[20:], 0)))
+	binary.BigEndian.PutUint16(p[10:12], ipCk(p[:20]))
+	return p
+}
