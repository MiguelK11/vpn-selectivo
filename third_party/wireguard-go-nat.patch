+func TestICMPInvalidAndUnmatchedRemainUntouched(t *testing.T) {
+	mutations := map[string]func([]byte){
+		"outer-length-overrun":     func(p []byte) { binary.BigEndian.PutUint16(p[2:4], 65535) },
+		"outer-length-short":       func(p []byte) { binary.BigEndian.PutUint16(p[2:4], 28) },
+		"fragmented-error":         func(p []byte) { p[6] |= 0x20 },
+		"quoted-fragment":          func(p []byte) { p[35] = 1; binary.BigEndian.PutUint16(p[38:40], ipCk(p[28:48])) },
+		"quoted-length-short":      func(p []byte) { p[31] = 20; binary.BigEndian.PutUint16(p[38:40], ipCk(p[28:48])) },
+		"unknown-port":             func(p []byte) { p[49] ^= 1 },
+		"unknown-remote":           func(p []byte) { p[47] ^= 1; binary.BigEndian.PutUint16(p[38:40], ipCk(p[28:48])) },
+		"wrong-quoted-source":      func(p []byte) { p[43] ^= 1; binary.BigEndian.PutUint16(p[38:40], ipCk(p[28:48])) },
+		"bad-quoted-checksum":      func(p []byte) { p[38] ^= 1 },
+		"bad-quoted-header":        func(p []byte) { p[28] = 0x4f },
+		"extension-length-overrun": func(p []byte) { p[25] = 255 },
+		"extension-length-short":   func(p []byte) { p[25] = 1 },
+		"redirect":                 func(p []byte) { p[20] = 5 },
+	}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			d := natted(&fake{})
+			outbound := pkt(6, lan, remote, 52000, 443, 0)
+			d.egress(outbound)
+			p := tooBig(outbound, 28)
+			mutate(p)
+			repairErrorChecksums(p)
+			before := append([]byte{}, p...)
+			d.ingress(p)
+			if !bytes.Equal(p, before) {
+				t.Fatal("malformed/unmatched packet changed")
+			}
+		})
+	}
+	for _, offset := range []int{10, 22} {
+		d := natted(&fake{})
+		outbound := pkt(6, lan, remote, 52000, 443, 0)
+		d.egress(outbound)
+		p := tooBig(outbound, 28)
+		p[offset] ^= 1
+		before := append([]byte{}, p...)
+		d.ingress(p)
+		if !bytes.Equal(p, before) {
+			t.Fatal("bad outer checksum was repaired and admitted")
+		}
+	}
+	// Every truncated prefix must remain byte-for-byte unchanged without panicking.
+	d := natted(&fake{})
+	outbound := pkt(6, lan, remote, 52000, 443, 0)
+	d.egress(outbound)
+	p := tooBig(outbound, 28)
+	for size := 0; size < len(p); size++ {
+		prefix := append([]byte{}, p[:size]...)
+		d.ingress(prefix)
+		if !bytes.Equal(prefix, p[:size]) {
+			t.Fatalf("truncated prefix %d changed", size)
+		}
+	}
+}
