@@ -0,0 +1,514 @@
+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+// ── reference checksums, computed from scratch (not the code under test) ──
+func fold(s uint32) uint16 {
+	for s>>16 != 0 {
+		s = s&0xffff + s>>16
+	}
+	return uint16(s)
+}
+func sum(b []byte, s uint32) uint32 {
+	for i := 0; i+1 < len(b); i += 2 {
+		s += uint32(b[i])<<8 | uint32(b[i+1])
+	}
+	if len(b)%2 == 1 {
+		s += uint32(b[len(b)-1]) << 8
+	}
+	return s
+}
+func ipCk(hdr []byte) uint16 {
+	h := append([]byte(nil), hdr...)
+	h[10], h[11] = 0, 0
+	return ^fold(sum(h, 0))
+}
+func l4Ck(proto byte, src, dst, seg []byte) uint16 {
+	s := sum(src, 0)
+	s = sum(dst, s)
+	s += uint32(proto) + uint32(len(seg))
+	c := append([]byte(nil), seg...)
+	off := map[byte]int{6: 16, 17: 6}[proto]
+	c[off], c[off+1] = 0, 0
+	return ^fold(sum(c, s))
+}
+
+// pkt builds ip(+l4) with correct checksums.
+func pkt(proto byte, src, dst [4]byte, sport, dport uint16, fragOff uint16) []byte {
+	l4len := 20
+	if proto == 17 {
+		l4len = 8
+	}
+	if proto == 1 {
+		l4len = 8
+	}
+	p := make([]byte, 20+l4len)
+	p[0] = 0x45
+	binary.BigEndian.PutUint16(p[2:4], uint16(len(p)))
+	binary.BigEndian.PutUint16(p[6:8], fragOff)
+	p[8] = 64
+	p[9] = proto
+	copy(p[12:16], src[:])
+	copy(p[16:20], dst[:])
+	l4 := p[20:]
+	switch proto {
+	case 6, 17:
+		binary.BigEndian.PutUint16(l4[0:2], sport)
+		binary.BigEndian.PutUint16(l4[2:4], dport)
+		if proto == 6 {
+			l4[12] = 5 << 4
+		} else {
+			binary.BigEndian.PutUint16(l4[4:6], uint16(l4len))
+		}
+		if fragOff&0x1fff == 0 {
+			off := map[byte]int{6: 16, 17: 6}[proto]
+			binary.BigEndian.PutUint16(l4[off:off+2], l4Ck(proto, src[:], dst[:], l4))
+		}
+	case 1:
+		l4[0] = byte(sport >> 8) // type smuggled via sport high byte for tests
+		binary.BigEndian.PutUint16(l4[4:6], dport)
+		binary.BigEndian.PutUint16(l4[2:4], ^fold(sum(l4, 0)))
+	}
+	binary.BigEndian.PutUint16(p[10:12], ipCk(p[:20]))
+	return p
+}
+
+// ── minimal fake device ──
+type fake struct {
+	in  [][]byte
+	out [][]byte
+	ev  chan tun.Event
+}
+
+func (f *fake) File() *os.File { return nil }
+func (f *fake) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	p := f.in[0]
+	f.in = f.in[1:]
+	copy(bufs[0][offset:], p)
+	sizes[0] = len(p)
+	return 1, nil
+}
+func (f *fake) Write(bufs [][]byte, offset int) (int, error) {
+	for _, b := range bufs {
+		f.out = append(f.out, append([]byte(nil), b[offset:]...))
+	}
+	return len(bufs), nil
+}
+func (f *fake) MTU() (int, error)        { return 1420, nil }
+func (f *fake) Name() (string, error)    { return "utun9", nil }
+func (f *fake) Events() <-chan tun.Event { return f.ev }
+func (f *fake) Close() error             { return nil }
+func (f *fake) BatchSize() int           { return 1 }
+
+var (
+	lan    = [4]byte{192, 168, 1, 13}
+	tunIP  = [4]byte{10, 69, 46, 118}
+	remote = [4]byte{1, 1, 1, 1}
+)
+
+func natted(f *fake) *natDevice { return newNATDevice(f, tunIP) }
+
+func egress1(t *testing.T, d *natDevice, p []byte) []byte {
+	bufs := [][]byte{make([]byte, 2048)}
+	sizes := []int{0}
+	d.Device.(*fake).in = append(d.Device.(*fake).in, p)
+	n, err := d.Read(bufs, sizes, 16)
+	if n != 1 || err != nil {
+		t.Fatalf("read: %v %v", n, err)
+	}
+	return bufs[0][16 : 16+sizes[0]]
+}
+
+func TestTCPEgressAndReply(t *testing.T) {
+	f := &fake{}
+	d := natted(f)
+	out := egress1(t, d, pkt(6, lan, remote, 52000, 443, 0))
+	if !bytes.Equal(out[12:16], tunIP[:]) {
+		t.Fatalf("src not rewritten: %v", out[12:16])
+	}
+	if got, want := binary.BigEndian.Uint16(out[10:12]), ipCk(out[:20]); got != want {
+		t.Fatalf("ip cksum: got %04x want %04x", got, want)
+	}
+	if got, want := binary.BigEndian.Uint16(out[36:38]), l4Ck(6, tunIP[:], remote[:], out[20:]); got != want {
+		t.Fatalf("tcp cksum: got %04x want %04x", got, want)
+	}
+	// reply comes back addressed to the tunnel; must be reversed to the LAN addr
+	reply := pkt(6, remote, tunIP, 443, 52000, 0)
+	if _, err := d.Write([][]byte{reply}, 0); err != nil {
+		t.Fatal(err)
+	}
+	got := f.out[0]
+	if !bytes.Equal(got[16:20], lan[:]) {
+		t.Fatalf("reply dst not reversed: %v", got[16:20])
+	}
+	if w := ipCk(got[:20]); binary.BigEndian.Uint16(got[10:12]) != w {
+		t.Fatal("reply ip cksum wrong")
+	}
+	if w := l4Ck(6, remote[:], lan[:], got[20:]); binary.BigEndian.Uint16(got[36:38]) != w {
+		t.Fatal("reply tcp cksum wrong")
+	}
+}
+
+func TestUDPZeroChecksumStaysZero(t *testing.T) {
+	d := natted(&fake{})
+	p := pkt(17, lan, remote, 5353, 53, 0)
+	p[26], p[27] = 0, 0 // zero UDP checksum = "none"
+	binary.BigEndian.PutUint16(p[10:12], ipCk(p[:20]))
+	out := egress1(t, d, p)
+	if out[26] != 0 || out[27] != 0 {
+		t.Fatalf("zero udp cksum was touched: %x%x", out[26], out[27])
+	}
+	if w := ipCk(out[:20]); binary.BigEndian.Uint16(out[10:12]) != w {
+		t.Fatal("ip cksum wrong")
+	}
+}
+
+func TestFragmentRewritesIPOnly(t *testing.T) {
+	d := natted(&fake{})
+	p := pkt(6, lan, remote, 52001, 443, 0x00c8) // frag offset 200: payload bytes, no L4 header
+	before := append([]byte(nil), p[20:]...)
+	out := egress1(t, d, p)
+	if !bytes.Equal(out[12:16], tunIP[:]) {
+		t.Fatal("frag src not rewritten")
+	}
+	if !bytes.Equal(out[20:], before) {
+		t.Fatal("frag payload was modified")
+	}
+	if w := ipCk(out[:20]); binary.BigEndian.Uint16(out[10:12]) != w {
+		t.Fatal("frag ip cksum wrong")
+	}
+}
+
+func TestICMPEcho(t *testing.T) {
+	f := &fake{}
+	d := natted(f)
+	out := egress1(t, d, pkt(1, lan, remote, 8<<8, 0xBEEF, 0)) // type 8 echo request
+	if !bytes.Equal(out[12:16], tunIP[:]) {
+		t.Fatal("icmp src not rewritten")
+	}
+	reply := pkt(1, remote, tunIP, 0<<8, 0xBEEF, 0) // type 0 echo reply
+	icmpCk := append([]byte(nil), reply[22:24]...)
+	d.Write([][]byte{reply}, 0)
+	got := f.out[0]
+	if !bytes.Equal(got[16:20], lan[:]) {
+		t.Fatal("icmp reply not reversed")
+	}
+	if !bytes.Equal(got[22:24], icmpCk) {
+		t.Fatal("icmp cksum should be untouched")
+	}
+}
