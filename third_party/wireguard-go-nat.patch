+func TestPathMTUErrorReachesOriginalFlow(t *testing.T) {
+	d := natted(&fake{})
+	outbound := pkt(6, lan, remote, 52000, 443, 0)
+	d.egress(outbound)
+	p := tooBig(outbound, 28)
+	d.ingress(p)
+	if !bytes.Equal(p[16:20], lan[:]) || !bytes.Equal(p[40:44], lan[:]) {
+		t.Fatal("ICMP too-big retains tunnel destination and quoted source; original TCP socket cannot match it")
+	}
+	if binary.BigEndian.Uint16(p[26:28]) != 1280 || fold(sum(p[20:], 0)) != 0xffff || ipCk(p[:20]) != binary.BigEndian.Uint16(p[10:12]) || ipCk(p[28:48]) != binary.BigEndian.Uint16(p[38:40]) {
+		t.Fatal("MTU or checksums not preserved")
+	}
+}
